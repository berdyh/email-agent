# Email Agent Configuration
# Copy to .env and fill in values. The root .env is loaded by both the CLI and
# the web server at startup.
#
# Agent mode, preferred agent, embedding provider, GCP project, and data dir are
# NOT env vars — they live in ~/.email-agent/settings.json
# (use `npx email-agent config set <key> <value>` or ./setup.sh).

# OpenAI (embeddings + direct-api mode)
OPENAI_API_KEY=

# Anthropic (claude-sdk executor)
ANTHROPIC_API_KEY=

# OpenRouter (embeddings + LLM access via openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-8b

# Set to 1 only for trusted remote deployments that need non-local browser writes.
# READ THIS BEFORE UNCOMMENTING: it does more than relax the header checks. It also
# turns OFF the browser unlock/session gate entirely, so anything that can reach the
# port reads your mail and approves queued Gmail changes without unlocking. Setting it
# HERE rather than in the shell disarms `npm run dev` / `npm run start` SILENTLY --
# next.config.ts loads this file, and only `email-agent serve` prints a warning when
# the gate is off. Leave it commented out unless you mean exactly that.
#EMAIL_AGENT_ALLOW_REMOTE_MUTATIONS=
