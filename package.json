{
  "name": "email-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Local AI-powered Gmail analysis tool",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "npm run test:build && npm run test:node && npm run test:components",
    "test:build": "npm run -w @email-agent/core build && npm run -w @email-agent/cli build",
    "test:node": "node --import tsx --test \"packages/**/*.test.ts\"",
    "test:components": "npm run -w @email-agent/web test",
    "test:coverage": "npm run test:build && node --import tsx --test --experimental-test-coverage \"packages/**/*.test.ts\"",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "setup": "./setup.sh",
    "start": "npm run -w @email-agent/web dev"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.63",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
